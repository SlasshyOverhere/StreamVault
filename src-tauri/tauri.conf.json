{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3255"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Suman Patgiri",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/slasshyvault.png",
      "icons/slasshyvault.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libdbus-1-3"
        ]
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "productName": "SlasshyVault",
  "mainBinaryName": "SlasshyVault",
  "version": "3.0.61",
  "identifier": "com.slasshyvault.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDQ0I5Mjk5NjFBQjU5MzEKUldReFdhdGhtWkxMVENNT1FNbWhZT0VUVmlJaEREdkR2akRGdFhFVDFHRWZIMnlUQ0JQSUtPN0UK",
      "endpoints": [
        "https://github.com/SlasshyOverhere/SlasshyVault/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "center": true,
        "label": "main",
        "fullscreen": false,
        "height": 901,
        "resizable": true,
        "title": "SlasshyVault",
        "width": 1395,
        "maximizable": false,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' asset: https://m.media-amazon.com https://images.metahub.space https://episodes.metahub.space https: data:; media-src 'self' asset: blob: https: http://localhost:* http://127.0.0.1:*; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost 'self' https://api.themoviedb.org https://api.imdbapi.dev https://v3-cinemeta.strem.io https://cinemeta-catalogs.strem.io https://images.metahub.space https://episodes.metahub.space https://www.googleapis.com https://slasshyvault.onrender.com ws://slasshyvault.onrender.com wss://slasshyvault.onrender.com http://localhost:* http://127.0.0.1:*; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/slasshyvault.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  }
}
